{
    "name": "p301/survey-app",
    "description": "Application web de gestion et création de sondages",
    "license": "MIT",
    "require": {
        "dotenv-org/phpdotenv-vault": "^0.2.4",
        "phpmailer/phpmailer": "^7.1",
        "ext-pdo": "*"
    },
    "autoload": {
        "psr-4": {
            "Controllers\\": "src/Controllers/",
            "Models\\": "src/Models/",
            "Views\\": "src/Views/",
            "_assets\\": "src/_assets/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "scripts": {
        "test": "phpunit"
    }
}
